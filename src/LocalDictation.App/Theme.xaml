<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
 xmlns:views="clr-namespace:LocalDictation.App.Views">
 <!-- Semantic MD3 roles. ThemeManager updates these brushes and the toolkit palette together. -->
 <SolidColorBrush x:Key="Canvas" Color="#FEF7FF"/>
 <SolidColorBrush x:Key="Surface" Color="#FFFBFE"/>
 <SolidColorBrush x:Key="SurfaceContainer" Color="#F3EDF7"/>
 <SolidColorBrush x:Key="SurfaceContainerHigh" Color="#ECE6F0"/>
 <SolidColorBrush x:Key="Ink" Color="#1D1B20"/>
 <SolidColorBrush x:Key="Muted" Color="#49454F"/>
 <SolidColorBrush x:Key="Accent" Color="#6750A4"/>
 <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="Border" Color="#CAC4D0"/>
 <SolidColorBrush x:Key="InputBorder" Color="#79747E"/>
 <SolidColorBrush x:Key="Selected" Color="#E8DEF8"/>
 <SolidColorBrush x:Key="SelectedInk" Color="#1D192B"/>
 <SolidColorBrush x:Key="Warning" Color="#8C1D18"/>
 <SolidColorBrush x:Key="Difference" Color="#FFD8E4"/>
 <SolidColorBrush x:Key="DifferenceInk" Color="#31111D"/>
 <SolidColorBrush x:Key="Recording" Color="#984061"/>
 <views:CapsuleCornerConverter x:Key="CapsuleCornerConverter"/>
 <CornerRadius x:Key="ShapeMedium">12</CornerRadius>
 <CornerRadius x:Key="ShapeLarge">16</CornerRadius>
 <!-- Roboto is bundled in the pinned toolkit; no network font dependency. -->
 <FontFamily x:Key="MaterialDesignFont">pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto</FontFamily>

 <Style TargetType="Window" BasedOn="{StaticResource MaterialDesignWindow}">
  <Setter Property="Icon" Value="/LocalDictation;component/Assets/waveform.ico"/>
  <Setter Property="FontFamily" Value="{StaticResource MaterialDesignFont}"/>
  <Setter Property="FontSize" Value="14"/>
  <Setter Property="Background" Value="{DynamicResource Canvas}"/>
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
 </Style>
 <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodyMediumTextBlock}">
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <!-- The native overlay must not inherit the toolkit Window's opaque background layer. -->
 <Style x:Key="CloudBannerWindow" TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
   <ContentPresenter ContentSource="Content"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Md3FocusVisual" TargetType="Control">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
   <!-- Focus adorner only; component templates remain the toolkit's. -->
   <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2">
    <!-- The 48-DIP focus boundary is four DIPs outside the 40-DIP body, with concentric endcaps. -->
    <Border.CornerRadius><MultiBinding Converter="{StaticResource CapsuleCornerConverter}">
     <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
     <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
    </MultiBinding></Border.CornerRadius>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Md3NavigationItem" TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesign3.NavigationDrawerListBoxItem}">
  <Setter Property="FocusVisualStyle" Value="{StaticResource Md3FocusVisual}"/>
  <Setter Property="Background" Value="{DynamicResource Accent}"/>
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
 </Style>
 <Style x:Key="Md3TextButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
  <Setter Property="FocusVisualStyle" Value="{StaticResource Md3FocusVisual}"/>
  <Setter Property="Height" Value="Auto"/><Setter Property="MinWidth" Value="48"/>
  <Setter Property="HorizontalAlignment" Value="Left"/>
  <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="16,8"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
  <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
 </Style>
 <Style x:Key="Md3FilledButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
  <Setter Property="FocusVisualStyle" Value="{StaticResource Md3FocusVisual}"/>
  <Setter Property="Height" Value="Auto"/><Setter Property="MinWidth" Value="48"/>
  <Setter Property="HorizontalAlignment" Value="Left"/>
  <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="24,8"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
  <Setter Property="md:ElevationAssist.Elevation" Value="Dp0"/>
  <Setter Property="Background" Value="{DynamicResource Accent}"/>
  <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
 </Style>
 <Style x:Key="Md3OutlinedButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
  <Setter Property="FocusVisualStyle" Value="{StaticResource Md3FocusVisual}"/>
  <Setter Property="Height" Value="Auto"/><Setter Property="MinWidth" Value="48"/>
  <Setter Property="HorizontalAlignment" Value="Left"/>
  <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="16,8"/>
  <Setter Property="Margin" Value="0,0,8,0"/>
  <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
  <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
 </Style>
 <Style x:Key="Md3IconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
  <Setter Property="FocusVisualStyle" Value="{StaticResource Md3FocusVisual}"/>
  <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/>
  <Setter Property="MinWidth" Value="48"/><Setter Property="MinHeight" Value="48"/>
  <Setter Property="Padding" Value="8"/>
  <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
 </Style>
 <Style TargetType="Button" BasedOn="{StaticResource Md3TextButton}"/>
 <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
  <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="16,12"/>
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="Background" Value="{DynamicResource Surface}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
  <Setter Property="SelectionBrush" Value="{DynamicResource Selected}"/>
  <Setter Property="SelectionTextBrush" Value="{DynamicResource SelectedInk}"/>
  <Setter Property="md:TextFieldAssist.TextFieldCornerRadius" Value="4"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
  <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="16,12"/>
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="Background" Value="{DynamicResource Surface}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
 </Style>
 <Style TargetType="TabControl" BasedOn="{StaticResource MaterialDesignTabControl}">
  <Setter Property="Background" Value="{DynamicResource Canvas}"/>
  <Setter Property="BorderThickness" Value="0"/>
 </Style>
 <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
  <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="16,8"/>
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
 </Style>
 <Style TargetType="ListBox" BasedOn="{StaticResource MaterialDesignListBox}">
  <Setter Property="Background" Value="{DynamicResource SurfaceContainer}"/>
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Padding" Value="8"/>
 </Style>
 <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
  <Setter Property="MinHeight" Value="48"/><Setter Property="Padding" Value="16,8"/>
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Style.Triggers><Trigger Property="IsSelected" Value="True">
   <Setter Property="Background" Value="{DynamicResource Selected}"/>
   <Setter Property="Foreground" Value="{DynamicResource SelectedInk}"/>
  </Trigger></Style.Triggers>
 </Style>
 <Style TargetType="RichTextBox" BasedOn="{StaticResource MaterialDesignRichTextBox}">
  <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
  <Setter Property="Background" Value="{DynamicResource Surface}"/>
  <Setter Property="SelectionBrush" Value="{DynamicResource Selected}"/>
  <Setter Property="SelectionOpacity" Value="1"/>
  <Setter Property="SelectionTextBrush" Value="{DynamicResource SelectedInk}"/>
  <Setter Property="IsInactiveSelectionHighlightEnabled" Value="True"/>
 </Style>
</ResourceDictionary>
