<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><ApplicationIcon>Assets\waveform.ico</ApplicationIcon></PropertyGroup>
  <ItemGroup><Resource Include="Assets\waveform.ico" /></ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LocalDictation.SourceRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Help\index.html" TargetPath="Help.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LocalDictation</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.0</Version>
    <Description>Local Windows dictation with original-weight ASR and interactive Review</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LocalDictation.Core/LocalDictation.Core.csproj" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
  </ItemGroup>
  <ItemGroup><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /></ItemGroup>
</Project>
